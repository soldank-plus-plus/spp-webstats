# production on purpose: it is what keeps TypeORM's synchronize off
NODE_ENV=production

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=webstats_test

# high enough that no functional test trips the limiter
THROTTLER_TTL_SECONDS=60
THROTTLER_LIMIT=100000

# two on purpose, so a list is covered and not just one origin
CORS_ORIGINS=https://soldankpp.app,http://localhost:5173
