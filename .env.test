# Environment for the integration and e2e suites, pointing at the throwaway
# database from docker-compose.test.yml. NODE_ENV is production on purpose:
# it is the only value that keeps TypeORM's synchronize off, so the suites run
# against a schema built by the migrations rather than one derived from the
# entities.
NODE_ENV=production

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=webstats_test

# high enough that the functional suites never trip the limiter, the rate
# limiting suite sets its own limit
THROTTLER_TTL_SECONDS=60
THROTTLER_LIMIT=100000
