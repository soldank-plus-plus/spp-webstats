NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=spp
DB_LOCAL_ROOT_PASSWORD=postgres

# Rate limiting, counted per client ip and per endpoint. Both are optional:
# left out, a window lasts 60 seconds and holds 120 requests in production
# and 300 in development.
# THROTTLER_TTL_SECONDS=60
# THROTTLER_LIMIT=300
